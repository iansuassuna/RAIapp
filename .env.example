# PostgreSQL (Docker Compose)
POSTGRES_USER=raiapp
POSTGRES_PASSWORD=raiapp
POSTGRES_DB=raiapp
POSTGRES_PORT=5433
APP_PORT=3000

DATABASE_URL=postgres://raiapp:raiapp@localhost:5433/raiapp
DATABASE_URL_TEST=postgres://raiapp:raiapp@localhost:5433/raiapp_test

# Better Auth (gere um segredo forte com: openssl rand -base64 32)
BETTER_AUTH_SECRET=raiapp-dev-secret-change-in-production-32chars
BETTER_AUTH_URL=http://localhost:3000

# Desenvolvimento: habilita seletor rápido de usuários (cria sessão real do Better Auth).
# Nunca é ativado quando NODE_ENV=production.
DEV_QUICK_SWITCH=true
DEV_SEED_PASSWORD=raitec123

# E-mail transacional (verificação de e-mail e redefinição de senha)
# MAIL_DRIVER: resend (padrão em produção) | console (padrão em dev: imprime o e-mail no log) | memory (testes)
MAIL_DRIVER=console
# Obrigatórios com MAIL_DRIVER=resend. MAIL_FROM precisa usar um domínio verificado no Resend.
RESEND_API_KEY=
MAIL_FROM="RAITec App <nao-responda@seu-dominio.com>"
